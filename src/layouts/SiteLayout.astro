---
import { categories, categoryIds, categoryUrl, site, type Category } from '../site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  active?: 'home' | Category
}

const { title, description = site.description, active } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} · ${site.title}` : site.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="site-width header-inner">
        <a class="wordmark" href="/">
          <span class="wordmark-stamp" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M4 6.5c3.5-.8 6-.3 8 1.5 2-1.8 4.5-2.3 8-1.5v10c-3.5-.8-6-.3-8 1.5-2-1.8-4.5-2.3-8-1.5zM12 8v10" />
              <path d="M6.5 9.8c1.1-.1 2.2.1 3 .5m-3 2.7c1.1-.1 2.2.1 3 .5" />
            </svg>
          </span>
          {site.title}
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>首页</a>
          {categoryIds.map((id) => (
            <a href={categoryUrl(id)} aria-current={active === id ? 'page' : undefined}>
              {categories[id].title}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer site-width">
      <span>{site.title}</span>
      <span>课程、研究与日常</span>
    </footer>
  </body>
</html>
