---
import PostList from '../components/PostList.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { getPosts } from '../posts'
import { site } from '../site'

const posts = await getPosts()
---

<SiteLayout active="home">
  <div class="site-width">
    <section class="masthead" aria-labelledby="site-title">
      <div class="masthead-copy">
        <p class="eyebrow"><span></span>{site.subtitle}</p>
        <h1 id="site-title">{site.title}</h1>
        <p class="masthead-description">{site.description}</p>
      </div>
      <svg class="masthead-figure" viewBox="0 0 330 178" fill="none" aria-hidden="true">
        <defs>
          <pattern id="masthead-grid" width="21" height="21" patternUnits="userSpaceOnUse" x="15" y="13">
            <path d="M 21 0 H 0 V 21" stroke="#d9ded1" stroke-width="1" />
          </pattern>
        </defs>
        <rect x="15" y="13" width="294" height="147" rx="1" fill="#f4f4ea" />
        <rect x="15" y="13" width="294" height="147" fill="url(#masthead-grid)" stroke="#d9ded1" />
        <path d="M15 118H309M162 13V160" stroke="#a0ab99" />
        <path d="M29 132C74 146 112 99 143 75C176 49 211 38 246 56C270 68 283 87 299 107" stroke="#63806a" stroke-width="1.8" />
        <path d="M32 45C84 48 118 123 174 132C224 140 251 83 291 62" stroke="#a29b78" stroke-width="1.3" stroke-dasharray="4 5" />
        <path d="M141 76H15M141 76V160" stroke="#7a927c" stroke-width=".8" stroke-dasharray="3 5" />
        <circle cx="141" cy="76" r="3.6" fill="#507457" stroke="#faf8f1" stroke-width="1.4" />
        <path d="M306 118l-5-2.5v5zM162 15l-2.5 5h5z" fill="#8f9b88" />
        <text x="21" y="28" fill="#637562" font-family="Georgia, serif" font-style="italic" font-size="11">y</text>
        <text x="294" y="151" fill="#637562" font-family="Georgia, serif" font-style="italic" font-size="11">x</text>
      </svg>
    </section>
    <section aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">最近更新</h2>
        <span>共 {posts.length} 篇</span>
      </div>
      <PostList posts={posts} />
    </section>
  </div>
</SiteLayout>
